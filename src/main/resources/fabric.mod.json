{
	"schemaVersion": 1,
	"id": "six-seven-blocker",
	"version": "${version}",
	"name": "six seven blocker",
	"description": "Removes any form of 6 7 (really really strict) from chat, replacing it with \"bad number\". This includes things like \"6 blah blah 7\", \"sSsIIIIXxX SEV33EENNNNN\", etc",
	"authors": [
		"ChrisThaBot"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/67-blocker",
		"sources": "https://github.com/christhabot/six-seven-blocker",
		"issues": "https://github.com/christhabot/six-seven-blocker/issues"
	},
	"license": "CC-BY-NC-ND-4.0",
	"icon": "assets/six-seven-blocker/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.christhabot.six_seven_blocker.SixSevenBlocker"
		],
		"client": [
			"io.github.christhabot.six_seven_blocker.SixSevenBlockerClient"
		]
	},
	"mixins": [
		"six-seven-blocker.mixins.json",
		{
			"config": "six-seven-blocker.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.2",
		"minecraft": "~1.21.4",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/AT7RdgZDj6"
			}
		}
	}
}